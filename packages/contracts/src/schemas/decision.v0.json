{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.evolutionos.io/v0/decision.json",
  "title": "Evolution decision v0",
  "type": "object",
  "required": ["proposalRef", "decision", "actor", "decidedAt", "rationale"],
  "properties": {
    "id": { "type": "string" },
    "proposalRef": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "digest": { "type": "string" }
      },
      "anyOf": [{ "required": ["version"] }, { "required": ["digest"] }],
      "additionalProperties": true
    },
    "decision": {
      "enum": ["accept", "reject", "defer", "investigate", "experiment", "supersede"]
    },
    "actor": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["human", "agent"] },
        "role": { "type": "string" }
      },
      "additionalProperties": true
    },
    "decidedAt": { "type": "string", "format": "date-time" },
    "rationale": { "type": "string", "minLength": 1 },
    "selectedAlternative": { "type": "string" },
    "conditions": { "type": "array", "items": { "type": "string" } },
    "reviewTriggers": { "type": "array", "items": { "type": "string" } },
    "dissent": { "type": "string" }
  },
  "additionalProperties": true
}
