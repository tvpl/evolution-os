{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.evolutionos.io/v0/module.json",
  "title": "EvolutionModule package v0 (estrutural; lifecycle completo no Slice 7)",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "compatibility", "components", "security"],
  "properties": {
    "apiVersion": { "const": "evolutionos.io/v1alpha1" },
    "kind": { "const": "EvolutionModule" },
    "metadata": {
      "type": "object",
      "required": ["id", "name", "version", "publisher"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "license": { "type": "string" }
      },
      "additionalProperties": true
    },
    "compatibility": {
      "type": "object",
      "required": ["hubProtocol", "nodeProtocol"],
      "additionalProperties": true
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "entrypoint", "capabilities"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "entrypoint": { "type": "string" },
          "capabilities": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "security": {
      "type": "object",
      "required": ["packageDigest"],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
